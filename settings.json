{
  "lastChangelogVersion": "0.85.1",
  "theme": "tokyonight-moon",
  "powerline": {
    "preset": "default",
    "welcome": false,
    "context": {
      "format": "percent"
    },
    "disabledSegments": [
      "cache_read",
      "cost"
    ],
    "separator": "pipe",
    "customItems": [
      {
        "id": "zai",
        "statusKey": "zai-statusline",
        "position": "secondary",
        "selfColorize": true
      }
    ]
  },
  "breadcrumb": "inner",
  "footer": true,
  "header": true,
  "header-info": true,
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3-flash",
  "packages": [
    "npm:pi-effort",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-free",
    "npm:pi-image-paste",
    "npm:pi-context-view",
    "npm:pi-mcp-adapter",
    "npm:zai-tools-lite",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-tool-display",
    "git:github.com/arshzip/no-vertical-padding",
    "npm:@juanibiapina/pi-tokyonight",
    "https://github.com/nicobailon/pi-powerline-footer",
    "https://github.com/hasit/pi-community-themes",
    "npm:@pi-kaush/pi-welcome-screen"
  ],
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "outputPad": 1,
  "autocompleteMaxVisible": 5,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "all",
  "fullscreenCopyOnSelect": true,
  "showLastPrompt": false
}
